APP_NAME=FlowChat
# O Compose força APP_ENV=production e APP_DEBUG=false nos containers.
# Para depuração estritamente local, use um override próprio e nunca o
# aplique no perfil de teste real.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# No teste real, use a URL pública HTTPS registrada no app Meta.
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=flowchat
DB_USERNAME=flowchat
# Obrigatório no Compose; use um valor forte e não versionado.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Maior que o --timeout do worker (90s) para evitar reprocessamento.
DB_QUEUE_RETRY_AFTER=120

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MESSENGER_APP_ID=
MESSENGER_APP_SECRET=
MESSENGER_LOGIN_CONFIG_ID=
MESSENGER_VERIFY_TOKEN=

# Cadastro aberto fica desativado; contas novas entram por convite.
FLOWCHAT_PUBLIC_REGISTRATION=false
# Emails autorizados a administrar convites da plataforma, separados por vírgula.
FLOWCHAT_PLATFORM_ADMIN_EMAILS=

# Área de preview de design (/preview/design-v2), somente leitura.
# Vazio: habilitada apenas com APP_ENV=local. false: desativada em qualquer
# ambiente. true: habilitada explicitamente (continua exigindo login, conta
# ativa e autorização administrativa nas telas de administração).
FLOWCHAT_PREVIEW_DESIGN_V2=

# Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels). Obrigatório apenas
# para o serviço `tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
